[Unit]
Description=Kenxu infrequent Jetson proxy connectivity checks
After=network-online.target donson-access.service
Wants=network-online.target

[Service]
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/donson-access/current
Environment=DATA_DIR=/home/jetson/donson-access/private-data
ExecStart=/usr/bin/node /home/jetson/donson-access/current/scripts/check-nodes.mjs
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jetson/donson-access/private-data

[Install]
WantedBy=multi-user.target
